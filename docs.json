{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "toern Retourenmanagement",
  "colors": {
    "primary": "#092523",
    "light": "#1FC16B",
    "dark": "#092523"
  },
  "favicon": {
    "light": "/images/toern-logomark.svg",
    "dark": "/images/toern-logomark.svg"
  },
  "navigation": {
    "languages": [
      {
        "language": "de",
        "default": true,
        "tabs": [
          {
            "tab": "Dokumentation",
            "groups": [
              {
                "group": "Erste Schritte",
                "pages": [
                  "index",
                  "quickstart"
                ]
              },
              {
                "group": "Integrationen",
                "pages": [
                  "integrations/ffn-connect-jtl-partner"
                ]
              }
            ]
          },
          {
            "tab": "API Reference",
            "groups": [
              {
                "group": "Overview",
                "pages": [
                  "api-reference/introduction"
                ]
              },
              {
                "group": "Endpoints",
                "openapi": {
                  "source": "toern-api-v1.json",
                  "directory": "api-reference"
                }
              }
            ]
          }
        ]
      },
      {
        "language": "en",
        "tabs": [
          {
            "tab": "Documentation",
            "groups": [
              {
                "group": "Getting Started",
                "pages": [
                  "en/index",
                  "en/quickstart"
                ]
              },
              {
                "group": "Integrations",
                "pages": [
                  "en/integrations/ffn-connect-jtl-partner"
                ]
              }
            ]
          },
          {
            "tab": "API Reference",
            "groups": [
              {
                "group": "Overview",
                "pages": [
                  "en/api-reference/introduction"
                ]
              },
              {
                "group": "Endpoints",
                "openapi": {
                  "source": "toern-api-v1.json",
                  "directory": "en/api-reference"
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/Logotype.svg",
    "dark": "/images/Logotype(1).svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@re-toern.de"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://admin.re-toern.de/"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "linkedin": "https://www.linkedin.com/company/toern",
      "website": "https://re-toern.de/"
    }
  },
  "api": {
    "params": {
      "expanded": "all"
    },
    "playground": {
      "display": "none"
    },
    "examples": {
      "defaults": "all"
    }
  },
  "redirects": [
    {
      "source": "/quickstart-2",
      "destination": "/quickstart"
    },
    {
      "source": "/ffn-connect-jtl-partner",
      "destination": "/integrations/ffn-connect-jtl-partner"
    }
  ]
}
