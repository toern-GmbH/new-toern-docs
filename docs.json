{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "toern Retourenmanagement",
  "colors": {
    "primary": "#092523",
    "light": "#1FC16B",
    "dark": "#092523"
  },
  "favicon": {
    "light": "/images/toern-logomark.svg",
    "dark": "/images/toern-logomark.svg"
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://mintlify.com/docs",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Blog",
          "href": "https://mintlify.com/blog",
          "icon": "newspaper"
        }
      ]
    },
    "languages": [
      {
        "language": "en",
        "pages": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "quickstart"
            ]
          }
        ]
      },
      {
        "language": "de",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "quickstart-2"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "ffn-connect-jtl-partner"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/Logotype.svg",
    "dark": "/images/Logotype(1).svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@re-toern.de"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://admin.re-toern.de/"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "linkedin": "https://www.linkedin.com/company/toern",
      "website": "https://re-toern.de/"
    }
  },
  "api": {
    "openapi": "toern-api-v1.json"
  }
}
